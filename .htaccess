#RewriteEngine on 
#RewriteCond %{REQUEST_FILENAME} !-d
#RewriteCond %{REQUEST_FILENAME}\.php -f
#RewriteRule ^(.*)$ $1.php [NC,L]

RewriteEngine on 
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(us|uk|in)/?$ index.php [L]
RewriteRule ^blogs/?$ blogs.php
RewriteRule ^privacy-policy?$ privacy-policy.php
RewriteRule ^terms-and-conditions?$ terms-of-conditions.php
RewriteRule ^(disclaimer)/?$ disclaimer.php
RewriteRule ^(faq)/?$ faqs.php
RewriteRule ^(action)/?$ action.php
RewriteRule ^(arcade)/?$ arcade.php
RewriteRule ^(casual)/?$ casual.php
RewriteRule ^(puzzle)/?$ puzzle.php
RewriteRule ^(imaging)/?$ imaging.php
RewriteRule ^(signin)/?$ signin.php
RewriteRule ^(about-us)/?$ about-us.php
RewriteRule ^(trending-now)/?$ trending-now.php
RewriteRule ^(sports)/?$ sports.php
RewriteRule ^(general-knowledge)/?$ general-knowledge.php
RewriteRule ^(entertainment)/?$ entertainment.php
RewriteRule ^(funny)/?$ funny.php
RewriteRule ^(contact-us)/?$ contact-us.php
RewriteRule ^(games)/?$ games.php
RewriteRule ^(regsiter)/?$ regsiter.php
RewriteRule ^view-game/([^/\.]+)$ view-game.php?game=$1 [L,QSA]
RewriteRule ^start-game/([^/\.]+)$ play-game.php?game_id=$1 [L,QSA]
RewriteRule ^blog-details/([^/\.]+)$ blog_single.php?blog=$1 [L,QSA]

ErrorDocument 404 /error/404.php


# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.nwoow\.com [NC]
RewriteRule ^(.*)$ https://nwoow.com/$1 [R=301,L]

# Redirect http to https
RewriteCond %{HTTPS} off
RewriteRule ^ https://nwoow.com%{REQUEST_URI} [L,R=301]

#GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result com unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php7_module>
   php_value error_reporting E_ALL & ~E_NOTICE & ~E_DEPRECATED
</IfModule>
<IfModule lsapi_module>
   php_value error_reporting E_ALL & ~E_NOTICE & ~E_DEPRECATED
</IfModule>
# END cPanel-generated php ini directives, do not edit
